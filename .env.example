DATABASE_URL="postgresql://crontract:crontract_dev_2024@localhost:5434/crontract"
NEXTAUTH_URL="http://localhost:3000"

# Authorization enforcement master switch. Unset/anything-but-"true" => OFF, meaning
# behaviour is identical to before the RBAC rollout (legacy admin/owner checks apply,
# no scope filtering, sensitive-page middleware gate inert). Set to "true" ONLY after
# the migration + backfill runbook in docs/PRODUCTION-FOLLOWUPS.md has been run and
# verified. Flip back to "false" for an instant rollback (no redeploy needed).
AUTHZ_ENFORCED="false"
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Email (optional - Resend). Without RESEND_API_KEY, emails are logged & skipped (no-op).
RESEND_API_KEY=""
EMAIL_FROM="Crontract <noreply@crontract.io>"

# MinIO / S3 (optional)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="crontract"
S3_SECRET_KEY="crontract_dev_2024"
S3_BUCKET="crontract-files"

# Redis
REDIS_URL="redis://localhost:6379"
